# Local secrets for `npm run dev`. Copy to .dev.vars (git-ignored) and fill in.
# Everything is optional: the built-in Alpha Engine needs no API key.

# Optional: let a Groq LLM polish the engine's answers (free key at https://console.groq.com/keys)
GROQ_API_KEY=

# Bearer token for GET /api/session/admin/sessions
ADMIN_TOKEN=

# Show error details in API responses while developing
ENVIRONMENT=development
