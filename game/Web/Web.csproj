<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser host for the engine: compiles CrimsonArena.Engine to
       WebAssembly and exposes it to JavaScript with [JSExport].
       `npm run game:build` publishes it into public/game/engine/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrimsonArena.Web</RootNamespace>
    <AssemblyName>CrimsonArena</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Static hosts (Cloudflare, Vercel) compress on the fly; keep plain files. -->
    <CompressionEnabled>false</CompressionEnabled>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <PublishTrimmed>true</PublishTrimmed>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.csproj" />
  </ItemGroup>
</Project>
